# Copy to .env and adjust if needed:  cp .env.example .env
# .env is git-ignored. Never commit real credentials - Session 2 will install a
# hook that blocks you, and Session 8 explains what to do if one ever leaks.

MSSQL_SA_PASSWORD=Your_strong_Passw0rd
MSSQL_PORT=1433

# Used by the API. Must match the values above.
ConnectionStrings__Default=Server=localhost,1433;Database=DevOpsLab;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Encrypt=False
API_PORT=8080
